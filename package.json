{
  "name": "arq",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/noto-kufi-arabic": "^0.4.3",
    "@expo/vector-icons": "^15.1.1",
    "@kingstinct/react-native-healthkit": "^16.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-three/fiber": "^9.8.1",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "expo-video": "~57.0.5",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "@types/three": "^0.186.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:db": "node supabase/tests/db.test.cjs",
    "test:plan": "node --experimental-strip-types --no-warnings tests/plan.test.ts",
    "test": "npm run test:plan && npm run test:inbody && npm run test:health && npm run test:coach && npm run test:training && npm run test:ranks && npm run test:clubs && npm run test:barcode && npm run test:db",
    "test:inbody": "node --experimental-strip-types --no-warnings tests/inbody.test.ts",
    "test:health": "node --experimental-strip-types --no-warnings tests/health.test.ts",
    "build:dev": "npx eas-cli@latest build --profile development --platform all",
    "build:preview": "npx eas-cli@latest build --profile preview --platform all",
    "beta:ios": "npx eas-cli@latest build --profile beta --platform ios --auto-submit",
    "beta:android": "npx eas-cli@latest build --profile beta --platform android --auto-submit",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview",
    "update:beta": "npx eas-cli@latest update --channel beta --environment preview",
    "update:production": "npx eas-cli@latest update --channel production --environment production",
    "test:coach": "npx esbuild@0.25 tests/coach.test.ts --bundle --platform=node --log-level=error --outfile=node_modules/.cache/coach.test.js && node node_modules/.cache/coach.test.js",
    "test:training": "npx esbuild@0.25 tests/training.test.ts --bundle --platform=node --log-level=error --outfile=node_modules/.cache/training.test.js && node node_modules/.cache/training.test.js",
    "test:ranks": "node --experimental-strip-types --no-warnings tests/ranks.test.ts",
    "test:clubs": "node --experimental-strip-types --no-warnings tests/clubs.test.ts",
    "test:barcode": "node --experimental-strip-types --no-warnings tests/barcode.test.ts",
    "db:bundle": "node tools/bundle-sql.mjs"
  },
  "private": true
}
