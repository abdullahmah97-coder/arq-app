{
  "expo": {
    "name": "ARQ أرك",
    "slug": "arq-app",
    "owner": "abdullahalhudaifs-team",
    "scheme": "arq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8EDDA",
    "extra": {
      "supportsRTL": true,
      "eas": {
        "projectId": "8e7b57a5-f97e-431c-bbad-113c0f9033d3"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "sa.arq.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSMotionUsageDescription": "لحساب خطواتك اليومية. To count your daily steps.",
        "NSAlarmKitUsageDescription": "لتشغيل منبّه الصحيان اللي تضبطه من بطاقة النوم. To ring the wake-up alarm you set on the sleep card."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "sa.arq.app",
      "adaptiveIcon": {
        "backgroundColor": "#F1551D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_SKIN_TEMPERATURE",
        "android.permission.health.READ_VO2_MAX",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["ar", "en"],
            "android": ["ar", "en"]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نستخدم موقعك للتأكد أنك داخل النادي عند تسجيل الحضور. We use your location to confirm you are at the gym when you check in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "لرفع صور التقدم والمنشورات، وإرسال الصور والفيديو في المحادثة. To upload progress photos and posts, and send photos and videos in chat.",
          "cameraPermission": "لتصوير وجباتك والجسم والمنشورات، ومسح باركود المنتجات لحساب السعرات، والصور والفيديو في المحادثة. To photograph meals, body and posts, scan product barcodes for calories, and take photos and videos for chat.",
          "microphonePermission": "لتسجيل الصوت مع الفيديو اللي ترسله في المحادثة. To record sound with videos you send in chat."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "لتصوير وجباتك والجسم والمنشورات، ومسح باركود المنتجات لحساب السعرات، والصور والفيديو في المحادثة. To photograph meals, body and posts, scan product barcodes for calories, and take photos and videos for chat.",
          "microphonePermission": "لتسجيل الصوت مع الفيديو اللي ترسله في المحادثة. To record sound with videos you send in chat.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#F8EDDA"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "نقرأ خطواتك ونومك ونبضك من Apple Health لحساب جاهزيتك وتعديل تمرينك. We read steps, sleep and heart data from Apple Health to score your recovery and adapt your workout.",
          "NSHealthUpdateUsageDescription": "لتسجيل تمارينك في Apple Health. To save your workouts to Apple Health.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "لحساب خطواتك اليومية. To count your daily steps."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F1551D",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Oasis",
            "ios": "./assets/icons/icon-oasis.png",
            "android": {
              "foregroundImage": "./assets/icons/android-fg-oasis.png",
              "backgroundColor": "#2F4B3C"
            }
          },
          {
            "name": "Dune",
            "ios": "./assets/icons/icon-dune.png",
            "android": {
              "foregroundImage": "./assets/icons/android-fg-dune.png",
              "backgroundColor": "#6E2A10"
            }
          },
          {
            "name": "Sand",
            "ios": "./assets/icons/icon-sand.png",
            "android": {
              "foregroundImage": "./assets/icons/android-fg-sand.png",
              "backgroundColor": "#F7DFBB"
            }
          },
          {
            "name": "Lavender",
            "ios": "./assets/icons/icon-lavender.png",
            "android": {
              "foregroundImage": "./assets/icons/android-fg-lavender.png",
              "backgroundColor": "#7B5BC4"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
